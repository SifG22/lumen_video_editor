<?xml version="1.0" encoding="utf-8"?>
<!--
  Lumen Video Editor MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build lumen.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files and a Start Menu shortcut. No file associations.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Lumen Video Editor"
      Manufacturer="SifG22"
      Version="$(var.Version)"
      UpgradeCode="31E6FB14-9DBC-41DD-B24B-26B71FB31B62"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Lumen Video Editor video editor" Manufacturer="SifG22" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Lumen Video Editor is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="LumenIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="LumenIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://sifg.net" />
    <Property Id="ARPURLUPDATEINFO" Value="https://sifg.net" />
    <Property Id="ARPHELPLINK" Value="https://sifg.net" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Lumen Video Editor" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Lumen Video Editor" Level="1">
      <ComponentGroupRef Id="LumenFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="LumenFiles" Directory="INSTALLFOLDER">
      <Component Id="LumenApp" Guid="15933017-925B-4963-8992-52000EB26AAA">
        <File Id="LumenExe" Source="$(var.BinDir)\lumen.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Lumen Video Editor"
              Description="Lumen Video Editor video editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="LumenIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\lumen.exe" Value="[#LumenExe]" Type="string" />
      </Component>

      <Component Id="LumenCli">
        <File Id="LumenCliExe" Source="$(var.BinDir)\lumen-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
