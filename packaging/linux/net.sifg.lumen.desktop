[Desktop Entry]
Type=Application
Name=Lumen Video Editor
GenericName=Video Editor
Comment=Edit video, color and sound
Exec=lumen %F
TryExec=lumen
Icon=net.sifg.lumen
Terminal=false
StartupNotify=true
StartupWMClass=net.sifg.lumen
Categories=AudioVideo;Video;AudioVideoEditing;
MimeType=application/x-lumen;video/mp4;video/x-m4v;video/quicktime;video/x-matroska;video/webm;video/vnd.avi;video/x-msvideo;application/mxf;video/mp2t;video/mpeg;video/3gpp;
Keywords=video;editor;film;timeline;color;grading;nle;
